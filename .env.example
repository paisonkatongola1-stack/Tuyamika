# --- Notifications hub (Milestone 2): optional SMTP + SMS gateway ---
APP_PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tuyamika.co.zm
SMTP_SECURE=0
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER=Tuyamika

# --- Firebase Authentication (optional) ---
# Leave FIREBASE_* unset to stay on local email/password auth.
# Firebase console -> Project settings -> General -> Web app config -> copy values.
# Client config (Expo app / web console reads via GET /api/auth/firebase-config):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key from service-account JSON; keep multiline \n escapes on one line:
FIREBASE_PRIVATE_KEY=
# Comma-separated emails that map to the admin role on first Firebase login:
FIREBASE_ADMIN_EMAILS=
# Expo app env (app/.env or shell): EXPO_PUBLIC_API_BASE_URL=https://localhost:3000
# Google sign in in the Expo web build also needs the *web app* config:
# EXPO_PUBLIC_FIREBASE_API_KEY, EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN,
# EXPO_PUBLIC_FIREBASE_PROJECT_ID, EXPO_PUBLIC_FIREBASE_APP_ID
