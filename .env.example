PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
RESERVATION_TTL_MINUTES=30
FREE_MAX_REGISTRIES=3
FREE_MAX_ITEMS=12
DATA_DIR=./data

